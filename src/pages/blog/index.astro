---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { formatDate } from "../../site";

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
const description = "Guides and results for Siftdog, the open-source, self-hosted Tavily alternative.";
---
<Base title="Blog — Siftdog" description={description} current="blog">
<header class="page-head">
  <p class="eyebrow">Blog</p>
  <h1>Guides and results</h1>
  <p class="lead">{description}</p>
</header>

<ul class="post-list">
  {posts.map((post) => (
    <li>
      <a class="card" href={`/blog/${post.id}/`}>
        <p class="meta">{formatDate(post.data.pubDate)}</p>
        <h2>{post.data.title}</h2>
        <p>{post.data.description}</p>
      </a>
    </li>
  ))}
</ul>
{posts.length === 0 && <p class="note">No posts yet.</p>}
</Base>
