---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { formatDate } from "../../site";

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
const description = "Guides and results for Siftdog, the open-source, self-hosted Tavily alternative.";
---
<Base title="Blog — Siftdog" description={description} current="blog">
<header>
  <h1>Blog</h1>
  <p class="tagline">{description}</p>
</header>

<ul class="post-list">
  {posts.map((post) => (
    <li>
      <a href={`/blog/${post.id}/`}>{post.data.title}</a>
      <p class="meta">{formatDate(post.data.pubDate)}</p>
      <p>{post.data.description}</p>
    </li>
  ))}
</ul>
{posts.length === 0 && <p class="note">No posts yet.</p>}
</Base>
